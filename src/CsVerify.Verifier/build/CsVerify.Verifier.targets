<Project>
  <!--
    Runs the CsVerify verifier after Build when CsVerifyEnabled is true:
      dotnet build -p:CsVerifyEnabled=true
    Its diagnostics use the canonical "file(line,col): error CSVnnnn: ..." format, so MSBuild and IDEs (and CI
    systems reading MSBuild's output) list them like compiler errors. Extra arguments go in CsVerifyArgs.

    The verifier is the csverify.dll next to this file's directory (a build of src/CsVerify.Verifier), or else the
    dotnet-csverify tool (this file comes with the CsVerify package): install it as a local or global tool
    (dotnet tool install dotnet-csverify). CsVerifyCommand overrides both.
  -->
  <PropertyGroup>
    <CsVerifyEnabled Condition="'$(CsVerifyEnabled)' == ''">false</CsVerifyEnabled>
    <CsVerifyArgs Condition="'$(CsVerifyArgs)' == ''"></CsVerifyArgs>
    <!-- the methods proved, kept between builds (the verifier's cache option): one is proved again only when what its
         proof depends on changes. CsVerifyCache=false proves them all every time; CsVerifyCacheFile moves it (a CI cache) -->
    <CsVerifyCache Condition="'$(CsVerifyCache)' == ''">true</CsVerifyCache>
    <CsVerifyCommand Condition="'$(CsVerifyCommand)' == '' and Exists('$(MSBuildThisFileDirectory)../csverify.dll')">dotnet &quot;$(MSBuildThisFileDirectory)../csverify.dll&quot;</CsVerifyCommand>
    <CsVerifyCommand Condition="'$(CsVerifyCommand)' == ''">dotnet csverify</CsVerifyCommand>
  </PropertyGroup>

  <!--
    A project's sources, for a project that references it: the verifier reads what they declare that the assembly
    doesn't say (an Entity Framework context's configuration). The project's own, and those of the projects it
    references (that have this target: that use CsVerify too), each tagged with its assembly's name.
  -->
  <PropertyGroup>
    <_CsVerifySourcesDependsOn Condition="'$(UsingMicrosoftNETSdk)' == 'true'">GenerateGlobalUsings</_CsVerifySourcesDependsOn>
  </PropertyGroup>
  <Target Name="CsVerifyGetSources" DependsOnTargets="$(_CsVerifySourcesDependsOn);_CsVerifyReferenceSources" Returns="@(_CsVerifyOwnSource)">
    <ItemGroup>
      <_CsVerifyOwnSource Include="@(Compile->'%(FullPath)')" CsVerifyAssembly="$(AssemblyName)" />
      <_CsVerifyOwnSource Include="@(_CsVerifyReferenceSource)" />
    </ItemGroup>
  </Target>

  <!-- the sources of the projects this one references, by the same properties their build was given (as ResolveProjectReferences does) -->
  <Target Name="_CsVerifyReferenceSources" DependsOnTargets="PrepareProjectReferences">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="CsVerifyGetSources" SkipNonexistentTargets="true" BuildInParallel="$(BuildInParallel)"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_CsVerifyReferenceSource" />
    </MSBuild>
  </Target>

  <!-- (not test projects, which are not written to be proved, nor projects that set CsVerifyExclude) -->
  <Target Name="CsVerify" AfterTargets="Build" DependsOnTargets="_CsVerifyReferenceSources"
          Condition="'$(CsVerifyEnabled)' == 'true' and '$(IsTestProject)' != 'true' and '$(CsVerifyExclude)' != 'true'"
          Inputs="@(Compile);@(_CsVerifyReferenceSource)" Outputs="$(IntermediateOutputPath)csverify.stamp">
    <ItemGroup>
      <!-- the project's sources, the SDK's under obj/ too (global usings, assembly attributes); its source generators
           run in the verifier, whose generated code is compiled with the program, not verified -->
      <_CsVerifySource Include="@(Compile)" />
    </ItemGroup>
    <ItemGroup>
      <_CsVerifyGenerator Include="@(Analyzer)" Condition="'%(Filename)' != 'CsVerify.Analyzers'" />
      <!-- the project's references, but Microsoft.NETCore.App's (the verifier has its own) and CsVerify's (its sources
           come with the verifier); the other shared frameworks' (ASP.NET Core's) are passed as a package's are. A
           project reference's implementation assembly, not its reference assembly: that has no private members, so
           no backing fields, by which the verifier knows a referenced entity's auto-properties (its columns) -->
      <_CsVerifyReference Include="@(ReferencePath)" Condition="'%(ReferencePath.FrameworkReferenceName)' != 'Microsoft.NETCore.App' And '%(Filename)' != 'CsVerify.Spec' And '%(Filename)' != 'CsVerify'" />
      <!-- the project's assembly name, so that what InternalsVisibleTo grants the project is visible -->
      <_CsVerifyArgs Include="--assembly-name $(AssemblyName)" />
      <_CsVerifyArgs Include="@(_CsVerifySource->'%(FullPath)')" />
      <_CsVerifyArgs Include="@(_CsVerifyReference->'-r %(FullPath)')" />
      <_CsVerifyArgs Include="@(_CsVerifyGenerator->'-a %(FullPath)')" />
      <_CsVerifyArgs Include="@(_CsVerifyReferenceSource->'--reference-source %(CsVerifyAssembly)=%(Identity)')" />
      <_CsVerifyArgs Include="@(EditorConfigFiles->'--analyzer-config %(FullPath)')" Condition="Exists('%(FullPath)')" />
    </ItemGroup>
    <PropertyGroup>
      <CsVerifyCacheFile Condition="'$(CsVerifyCacheFile)' == ''">$(ProjectDir)$(IntermediateOutputPath)csverify.cache</CsVerifyCacheFile>
    </PropertyGroup>
    <ItemGroup Condition="'$(CsVerifyCache)' == 'true'">
      <_CsVerifyArgs Include="--cache $(CsVerifyCacheFile)" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)csverify.rsp" Lines="@(_CsVerifyArgs)" Overwrite="true" />
    <PropertyGroup>
      <!-- the project's nullable context: its non-nullable reference types are contracts (unset means disabled) -->
      <_CsVerifyNullable>$(Nullable)</_CsVerifyNullable>
      <_CsVerifyNullable Condition="'$(_CsVerifyNullable)' == ''">disable</_CsVerifyNullable>
    </PropertyGroup>
    <Exec Command="$(CsVerifyCommand) --nullable $(_CsVerifyNullable) $(CsVerifyArgs) @&quot;$(IntermediateOutputPath)csverify.rsp&quot;" />
    <Touch Files="$(IntermediateOutputPath)csverify.stamp" AlwaysCreate="true" />
  </Target>

  <!--
    Proof erasure, when CsVerifyErase is true:
      dotnet build -p:CsVerifyErase=true
    Before the compile steps, `csverify erase` rewrites this project's sources with every proof removed
    (specifications, lemmas, ghost parameters, views), adds the erased CsVerify runtime, and checks that the result
    compiles. The compiler then builds those sources instead, without the CsVerify assembly; #line directives keep
    diagnostics, stack traces and the debugger on the original files. A normal build compiles the originals again.
    It runs before BeforeCompile, so that what hooks in after it sees the erased program: Tarp's MC/DC
    instrumentation (dotnet tarp test -p:CsVerifyErase=true) measures the code that runs, not the specifications.
  -->
  <!--
    A checked build, when CsVerifyChecked is true: the same, but the specifications that can run are kept as run-time
    checks (csverify erase with its checked option; docs/erasure.md), to test the program against them.
      dotnet build -p:CsVerifyChecked=true
  -->
  <PropertyGroup>
    <CsVerifyErase Condition="'$(CsVerifyErase)' == ''">false</CsVerifyErase>
    <CsVerifyChecked Condition="'$(CsVerifyChecked)' == ''">false</CsVerifyChecked>
    <CsVerifyErase Condition="'$(CsVerifyChecked)' == 'true'">true</CsVerifyErase>
  </PropertyGroup>

  <!-- Switching between erased and normal builds must recompile: the mode file changes only when the mode does. -->
  <Target Name="CsVerifyEraseMode" BeforeTargets="BeforeCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)csverify-erase.mode" Lines="$(CsVerifyErase) $(CsVerifyChecked)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <CustomAdditionalCompileInputs Include="$(IntermediateOutputPath)csverify-erase.mode" />
    </ItemGroup>
  </Target>

  <Target Name="CsVerifyErase" BeforeTargets="BeforeCompile" DependsOnTargets="CsVerifyEraseMode" Condition="'$(CsVerifyErase)' == 'true'">
    <PropertyGroup>
      <!-- set here, not at import time: this file may be imported before the SDK defines the paths. Under obj/ (so
           not in the default Compile items) but outside the intermediate directory, which coverage tools such as
           Tarp take for generated code and leave alone; the erased sources are the program that runs. -->
      <CsVerifyErasedDir>$(ProjectDir)$(BaseIntermediateOutputPath)csverify-erased/$(Configuration)/$(TargetFramework)/</CsVerifyErasedDir>
    </PropertyGroup>
    <ItemGroup>
      <_CsVerifyEraseArgs Include="--assembly-name $(AssemblyName)" />
      <_CsVerifyEraseArgs Include="@(Compile->'%(FullPath)')" />
      <_CsVerifyEraseArgs Include="@(ReferencePathWithRefAssemblies->'-r %(FullPath)')" />
      <_CsVerifyEraseArgs Include="@(Analyzer->'-a %(FullPath)')" Condition="'%(Filename)' != 'CsVerify.Analyzers'" />
      <_CsVerifyEraseArgs Include="@(EditorConfigFiles->'--analyzer-config %(FullPath)')" Condition="Exists('%(FullPath)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)csverify-erase.rsp" Lines="@(_CsVerifyEraseArgs)" Overwrite="true" />
    <PropertyGroup>
      <_CsVerifyCheckedOption Condition="'$(CsVerifyChecked)' == 'true'">--checked</_CsVerifyCheckedOption>
    </PropertyGroup>
    <Exec Command="$(CsVerifyCommand) erase $(_CsVerifyCheckedOption) --out &quot;$(CsVerifyErasedDir).&quot; @&quot;$(IntermediateOutputPath)csverify-erase.rsp&quot;" />
    <ItemGroup>
      <Compile Remove="@(Compile)" />
      <Compile Include="$(CsVerifyErasedDir)**/*.cs" />
      <_CsVerifyAssembly Include="@(ReferencePathWithRefAssemblies)" Condition="'%(Filename)' == 'CsVerify.Spec' Or '%(Filename)' == 'CsVerify'" />
      <ReferencePathWithRefAssemblies Remove="@(_CsVerifyAssembly)" />
      <_CsVerifyAssemblyPath Include="@(ReferencePath)" Condition="'%(Filename)' == 'CsVerify.Spec' Or '%(Filename)' == 'CsVerify'" />
      <ReferencePath Remove="@(_CsVerifyAssemblyPath)" />
      <!-- the CsVerify analyzers check the program with its proofs (the normal build); the erased one has none -->
      <_CsVerifyAnalyzer Include="@(Analyzer)" Condition="'%(Filename)' == 'CsVerify.Analyzers'" />
      <Analyzer Remove="@(_CsVerifyAnalyzer)" />
    </ItemGroup>
  </Target>
</Project>
