<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>csverify</AssemblyName>
    <RootNamespace>CsVerify.Verifier</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <!-- dotnet-csverify: run as "dotnet csverify" -->
    <ToolCommandName>dotnet-csverify</ToolCommandName>
    <PackageId>dotnet-csverify</PackageId>
    <!-- run on whatever (newer) runtime the build machine has -->
    <RollForward>Major</RollForward>
    <Description>The CsVerify verifier: proves C# code's CsVerify specifications (contracts, loop invariants, termination, views) with Z3, and erases the proofs. Run "dotnet csverify", or build with -p:CsVerifyEnabled=true.</Description>
    <PackageTags>verification;formal-methods;contracts;z3;smt</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <!-- Boogie, the intermediate verification language Dafny and Spec# use: the engine run with -engine boogie (docs/boogie.md) -->
    <PackageReference Include="Boogie.ExecutionEngine" Version="3.5.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- The analyzers (linearity, ghost hygiene, purity) run inside the verifier too: a method is verified only if they accept it. -->
    <ProjectReference Include="..\CsVerify.Analyzers\CsVerify.Analyzers.csproj" />
    <!-- The verifier compiles user code against the Spec sources so it can read the library's own contracts (Mem.*). -->
    <EmbeddedResource Include="..\CsVerify.Spec\*.cs" LogicalName="CsVerify.Spec.%(Filename)%(Extension)" />
    <!-- and the contracts it ships for the BCL ([ContractsFor] stubs, CsVerify.Bcl) -->
    <EmbeddedResource Include="..\CsVerify.Spec\Bcl\*.cs" LogicalName="CsVerify.Spec.Bcl.%(Filename)%(Extension)" />
    <!-- and Entity Framework Core's model (CsVerify.Ef), compiled in only for programs that reference EF Core -->
    <EmbeddedResource Include="..\CsVerify.Spec\Ef\*.cs" LogicalName="CsVerify.Ef.%(Filename)%(Extension)" />
    <None Include="build\CsVerify.Verifier.targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
