<Project Sdk="Microsoft.NET.Sdk">
  <!-- The model of samples/EfAspNet: a context derived from ASP.NET Core Identity's, in a project that references the
       ASP.NET Core shared framework. The verifier is given the framework's reference assemblies (its targeting pack's),
       which can't be loaded: it loads the shared framework's in their place to ask EF for its model. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CsVerifyVersion Condition="'$(CsVerifyVersion)' == ''">0.5.27</CsVerifyVersion>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CsVerify" Version="$(CsVerifyVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>
</Project>
