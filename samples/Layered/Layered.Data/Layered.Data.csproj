<Project Sdk="Microsoft.NET.Sdk">
  <!-- the data: the context, which applies the domain's configurations (not verified here) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CsVerifyExclude>true</CsVerifyExclude>
    <CsVerifyVersion Condition="'$(CsVerifyVersion)' == ''">0.5.21</CsVerifyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CsVerify" Version="$(CsVerifyVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <ProjectReference Include="../Layered.Model/Layered.Model.csproj" />
  </ItemGroup>
</Project>
