<Project Sdk="Microsoft.NET.Sdk">
  <!-- An EF Core project as a user has it: the SQLite provider from its package, the model configured in
       configuration classes. The verifier asks EF for its model, which loads the provider and its native library
       (samples/e2e.sh checks it does, on each system): every method verifies only by that model. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CsVerifyVersion Condition="'$(CsVerifyVersion)' == ''">0.5.27</CsVerifyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CsVerify" Version="$(CsVerifyVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>
</Project>
