<Project Sdk="Microsoft.NET.Sdk">
  <!-- A library that references EF Core alone: no provider (its host picks the database) and no relational package.
       The verifier builds EF's model with a provider of its own, a relational one, with EF's relational package of the
       same version from the packages folder (samples/e2e.sh: the samples before it restore that version). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CsVerifyVersion Condition="'$(CsVerifyVersion)' == ''">0.5.27</CsVerifyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CsVerify" Version="$(CsVerifyVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>
</Project>
