<Project Sdk="Microsoft.NET.Sdk">
  <!-- CsLemon: the LEMON LALR(1) parser generator (sqlite.org/lemon.html), ported from C to C# and checked by CsVerify. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <RootNamespace>CsLemon</RootNamespace>
    <AssemblyName>cslemon</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CsVerify.Spec\CsVerify.Spec.csproj" />
    <ProjectReference Include="..\CsLemon.Runtime\CsLemon.Runtime.csproj" />
    <ProjectReference Include="..\..\src\CsVerify.Analyzers\CsVerify.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- the parser template, as in Lemon: looked for next to the executable -->
    <None Include="lempar.c" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
