<Project Sdk="Microsoft.NET.Sdk">
  <!-- Entity Framework Core: the verifier's model of it, the EF samples, and the model checked against EF itself on
       SQLite and on SQL Server (in a container, Testcontainers; Docker needed) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Testcontainers.MsSql" Version="3.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CsVerify.Spec\CsVerify.Spec.csproj" />
    <ProjectReference Include="..\..\src\CsVerify.Analyzers\CsVerify.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\CsVerify.Verifier\CsVerify.Verifier.csproj" />
    <Compile Include="..\CsVerify.Tests\Harness.cs" Link="Harness.cs" />
  </ItemGroup>
</Project>
